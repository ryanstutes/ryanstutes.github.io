source "https://rubygems.org"

gem "jekyll"

# GitHub Pages enables these by default in production, which is why pages
# like experience.md (no front matter, no explicit layout) render correctly
# when deployed. Installing them locally keeps `jekyll serve` matching what
# actually ships.
gem "jekyll-optional-front-matter"
gem "jekyll-titles-from-headings"
gem "jekyll-default-layout"
